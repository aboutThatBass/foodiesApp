<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.calorieapp.controller.LoginController"
      style="-fx-background-color: #5C93C5;"
      alignment="CENTER"
      spacing="20"
      prefWidth="600" prefHeight="400">

    <children>
        <Label text="Log In" style="-fx-font-size: 32px; -fx-font-weight: bold;" />

        <TextField fx:id="usernameField" promptText="Email"
                   prefWidth="250" />

        <PasswordField fx:id="passwordField" promptText="Password"
                       prefWidth="250" />

        <Button text="Submit" prefWidth="200"
                onAction="#handleLogin" />
    </children>

</VBox>



