<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.calorieapp.controller.GoalController"
      style="-fx-background-color: #5C93C5;"
      alignment="TOP_CENTER"
      spacing="25"
      prefWidth="700" prefHeight="500">

    <children>

        <!-- Title -->
        <Label text="Weekly Total" style="-fx-font-size: 32px; -fx-font-weight: bold;" />

        <!-- Main Content Row -->
        <HBox alignment="CENTER" spacing="40">

            <children>

                <!-- LEFT BOX -->
                <VBox style="-fx-border-color: #CCC; -fx-background-color: #F4F4F4; -fx-padding: 20;"
                      prefWidth="200" prefHeight="180" alignment="CENTER">

                    <children>
                        <Label text="Total Weekly Metrics" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        <Label text="(Auto calculation soon)" style="-fx-font-size: 12px;" />
                    </children>

                </VBox>

                <!-- RIGHT BUTTON SECTION -->
                <VBox alignment="CENTER" spacing="15">

                    <children>
                        <Button text="Total Weekly Calories" prefWidth="200" />
                        <Button text="Total Weekly Protein" prefWidth="200" />
                        <Button text="Total Weekly Fats" prefWidth="200" />
                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- Back Button -->
        <Button text="Back" prefWidth="150" onAction="#handleBack" />

    </children>

</VBox>

