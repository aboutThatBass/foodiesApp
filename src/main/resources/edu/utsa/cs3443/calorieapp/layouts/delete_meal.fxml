<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="450" prefWidth="600" spacing="20" style="-fx-background-color: #5C93C5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.calorieapp.controller.DeleteMealController">

    <children>

        <Label style="-fx-font-size: 28px;" text="Delete Meal" />
        <HBox alignment="CENTER" prefHeight="53.0" prefWidth="600.0">
            <children>
                <Label text="Please Enter Meal ID">
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                    <font>
                        <Font size="14.0" />
                    </font></Label>
                <TextField fx:id="idField" promptText="ID" />
            <Button fx:id="goButton" mnemonicParsing="false" onAction="#handleGo" text="Go">
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
            </Button>
            </children>
        </HBox>
      <TextArea fx:id="outputArea" prefHeight="37.0" prefWidth="559.0">
         <VBox.margin>
            <Insets left="10.0" right="10.0" />
         </VBox.margin>
      </TextArea>

        <Button fx:id="deleteButton" onAction="#handleDelete" prefWidth="150" text="Delete" />

        <Button fx:id="backButton" onAction="#handleBack" prefWidth="150" text="Back" />

    </children>

</VBox>
